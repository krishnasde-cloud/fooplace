{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/orders/expire/",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/admin(?:/(.*))?",
      "dest": "/api"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/api/$1"
        }
      ]
    },
    {
      "src": "^/(sitemap\\.xml|robots\\.txt)$",
      "dest": "/api"
    },
    {
      "src": "^/listings(/.*)?$",
      "dest": "/api"
    },
    {
      "src": "^/sellers/\\d+/?$",
      "dest": "/api"
    },
    {
      "src": "^/$",
      "dest": "/api"
    },
    {
      "src": "^/(sell|orders)(/.*)?$",
      "dest": "/index.html"
    }
  ]
}
