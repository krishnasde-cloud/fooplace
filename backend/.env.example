# Clerk (https://dashboard.clerk.com → API keys)
#
# Server-only. Do not prefix with VITE_. On Vercel these are project env
# vars (Django runs as api/index.py). Locally they are also read by Docker Compose.

# Required to verify Clerk session tokens
CLERK_SECRET_KEY=

# Optional PEM public key for networkless JWT verification
# CLERK_JWT_KEY=

# Comma-separated frontend origins allowed in the token azp claim.
# Already set on Vercel; this default is for local Vite.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
