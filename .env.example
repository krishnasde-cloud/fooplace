# Local Docker Postgres (docker compose sets these automatically).
POSTGRES_DB=fooplace
POSTGRES_USER=fooplace
POSTGRES_PASSWORD=fooplace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Used by the Django container. Host tools can reuse the published port.
DATABASE_URL=postgres://fooplace:fooplace@127.0.0.1:5432/fooplace

# Clerk — Docker Compose forwards these into the backend/frontend containers.
# On Vercel, set the same names on the project (CLERK_AUTHORIZED_PARTIES is already set).
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Server-only. Django geocodes seller pickup addresses with this key.
GEOAPIFY_API_KEY=
