# Clerk (https://dashboard.clerk.com → API keys)
#
# Add these on Vercel: Project → Settings → Environment Variables
# Vite inlines VITE_* at build time, so the publishable key must be present
# when the frontend is built (Vercel build, or GitHub Actions if using Bazel).

# Required — public, safe to expose in the browser
VITE_CLERK_PUBLISHABLE_KEY=

# Not used by this Vite SPA. Add later only if Django verifies Clerk JWTs.
# CLERK_SECRET_KEY=
